{
  "name": "astrava",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "build:api": "tsc --noEmit -p tsconfig.server.json",
    "dev:api": "node --experimental-strip-types server/src/index.ts",
    "start:api": "node --experimental-strip-types server/src/index.ts",
    "test": "node --experimental-strip-types --test src/astrology/tests/*.test.mjs src/features/interpretations/tests/*.test.mjs src/features/vault/tests/*.test.mjs server/tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vvo/tzdb": "^6.204.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
